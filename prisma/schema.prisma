// Lustre — Salon Management Platform
// Prisma schema (PostgreSQL)
//
// NOTE: this sandbox can't reach binaries.prisma.sh to download the Prisma
// engines, so `prisma generate` / `prisma migrate` couldn't be run here.
// Run `npx prisma generate` and `npx prisma migrate dev` in an environment
// with normal network access (your machine, CI, or Vercel) before first use.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  RECEPTIONIST
  STYLIST
  CUSTOMER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationEvent {
  BOOKING_CONFIRMATION
  APPOINTMENT_REMINDER
  INVOICE_SENT
  PAYMENT_CONFIRMATION
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

/// One row per salon business — every other model is scoped to a Salon so
/// the platform can host many salons on shared infrastructure.
model Salon {
  id        String   @id @default(cuid())
  name      String
  address   String
  phone     String
  email     String
  gstin     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  customers  Customer[]
  staff      Staff[]
  services   Service[]
  appointments Appointment[]
  invoices   Invoice[]
  inventory  InventoryItem[]
  notifications Notification[]
  subscription Subscription?

  @@map("salons")
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

// Paid access gate: a salon owner must complete a payment before the
// dashboard is usable. One row per salon (the whole salon shares one
// subscription, not one per staff login) — see requireActiveSubscription()
// in src/lib/subscription.ts for how this is enforced.
model Subscription {
  id                String             @id @default(cuid())
  salonId           String             @unique
  salon             Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("subscriptions")
}

/// Login-capable account. Owners/Receptionists/Stylists are staff-side users;
/// Customers may optionally have an account for the booking portal & history.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  // Auth.js Prisma adapter writes these two on every OAuth sign-in; the
  // adapter throws "Unknown argument `image`" if either column is missing.
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null when the account only uses Google OAuth
  // Defaults to CUSTOMER because the Auth.js Prisma adapter creates this
  // row itself on a brand-new OAuth (Google) sign-in and only populates
  // id/name/email/image — it has no way to know the real role. The
  // explicit signup flow (POST /api/auth/signup) overrides this with
  // OWNER when someone signs up as a salon owner directly.
  role          Role      @default(CUSTOMER)
  salonId       String?
  salon         Salon?    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staffId       String?   @unique
  staff         Staff?    @relation(fields: [staffId], references: [id])
  customerId    String?   @unique
  customer      Customer? @relation(fields: [customerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  passwordResetTokens PasswordResetToken[]

  @@index([salonId])
  @@map("users")
}

// F-04 (security audit): real password-reset flow. Only the SHA-256 hash
// of the token is stored (same principle as passwordHash — if this table
// ever leaked, the raw tokens in it are useless), it's single-use
// (usedAt), and short-lived (expiresAt, enforced in the reset route, not
// just at generation time).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Auth.js (NextAuth) v5 compatible models — wire up the Prisma adapter and
// a Google provider against these for real OAuth + JWT session support.
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Core salon operations
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  birthday      String? // MM-DD
  notes         String?
  loyaltyPoints Int      @default(0)
  tags          String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments Appointment[]
  invoices     Invoice[]
  user         User?

  @@index([salonId])
  @@index([phone])
  @@map("customers")
}

model Staff {
  id              String      @id @default(cuid())
  salonId         String
  salon           Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name            String
  role            String
  phone           String
  email           String
  workingHours    String
  skills          String[]    @default([])
  rating          Float       @default(5)
  commissionRate  Float       @default(10) // percent
  status          StaffStatus @default(ACTIVE)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user         User?
  services     ServiceStaff[]
  appointments Appointment[]
  attendance   Attendance[]
  leaveRequests LeaveRequest[]

  @@index([salonId])
  @@map("staff")
}

model Service {
  id              String   @id @default(cuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name            String
  category        String
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  staff        ServiceStaff[]
  appointments Appointment[]

  @@index([salonId])
  @@map("services")
}

/// Explicit join table for the Service <-> Staff many-to-many ("assigned
/// staff" per service), so we can later attach metadata (e.g. proficiency).
model ServiceStaff {
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([serviceId, staffId])
  @@map("service_staff")
}

model Appointment {
  id              String            @id @default(cuid())
  salonId         String
  salon           Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id])
  staffId         String
  staff           Staff             @relation(fields: [staffId], references: [id])
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id])
  date            DateTime          @db.Date
  time            String // "HH:mm" — stored separately from date for fast slot queries
  durationMinutes Int
  price           Decimal           @db.Decimal(10, 2)
  status          AppointmentStatus @default(PENDING)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  invoice Invoice?

  @@index([salonId, date])
  @@index([staffId, date])
  @@index([customerId])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Invoice {
  id              String        @id @default(cuid())
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  appointmentId   String?       @unique
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  tax             Decimal       @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod
  pdfUrl          String? // Cloudinary URL once generated
  emailSent       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  // Was a bare `@unique` on invoiceNumber — that's a GLOBAL constraint, so
  // two salons both issuing "INV-0001" would collide. Scoping the
  // uniqueness to (salonId, invoiceNumber) is what actually makes this a
  // multi-tenant-safe field. Generate invoiceNumber server-side inside a
  // transaction (see /api/invoices) — never trust a client-supplied number.
  @@unique([salonId, invoiceNumber])
  @@index([salonId])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceName String
  qty         Int     @default(1)
  price       Decimal @db.Decimal(10, 2)

  @@map("invoice_items")
}

/// A single transaction against an invoice — supports partial payments
/// (multiple Payment rows can sum to less than, or equal to, the total).
model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  paidAt    DateTime      @default(now())

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model InventoryItem {
  id            String   @id @default(cuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name          String
  category      String
  quantity      Int
  unit          String
  reorderLevel  Int
  supplier      String
  costPerUnit   Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases PurchaseRecord[]

  @@index([salonId])
  @@map("inventory_items")
}

model PurchaseRecord {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Int
  costPerUnit     Decimal       @db.Decimal(10, 2)
  purchasedAt     DateTime      @default(now())

  @@map("purchase_records")
}

// ---------------------------------------------------------------------------
// Staff operations
// ---------------------------------------------------------------------------

model Attendance {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  present   Boolean  @default(true)

  @@unique([staffId, date])
  @@map("attendance")
}

model LeaveRequest {
  id        String      @id @default(cuid())
  staffId   String
  staff     Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date
  reason    String?
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())

  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Notifications (Email / SMS / WhatsApp)
// ---------------------------------------------------------------------------

model Notification {
  id        String              @id @default(cuid())
  salonId   String
  salon     Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  event     NotificationEvent
  recipient String // phone or email depending on channel
  status    NotificationStatus  @default(QUEUED)
  payload   Json?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([salonId, createdAt])
  @@map("notifications")
}
